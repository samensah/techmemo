# Set these in Vercel > Project Settings > Environment Variables, then redeploy.
# OAuth client type: Web application. Never commit real values.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Generate your own: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Exact canonical HTTPS origin, with no path (no trailing slash is fine).
APP_URL=https://techmemo-smoky.vercel.app
