{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "node scripts/build-static.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/projects/accept",
      "destination": "/api/projects?action=accept"
    },
    {
      "source": "/api/projects/:id/invites",
      "destination": "/api/projects?id=:id&action=invite"
    },
    {
      "source": "/api/projects/:id",
      "destination": "/api/projects?id=:id"
    }
  ]
}
